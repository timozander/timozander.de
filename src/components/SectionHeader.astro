---
interface Props {
	title?: string;
	subheading?: string;
	class?: string;
}

const { title, subheading, class: className = "" } = Astro.props;
---

<div class:list={["flex flex-col gap-2", { className }]}>
	{
		title && (
			<span class="font-code text-muted-foreground text-sm font-medium tracking-[0.15em] uppercase">
				{title}
			</span>
		)
	}
	{subheading && <p class="text-muted-foreground max-w-xl text-sm leading-relaxed">{subheading}</p>}
</div>
