---
import siteConfig from "@/site.config";
import { getAssetPath } from "@/utils/url";

const pathname = Astro.url.pathname;

function isActive(url: string) {
  if (url === "/") {
    return pathname === "/";
  }

  return pathname.startsWith(url);
}
---

<header
  class="site-header border-border bg-background/85 sticky top-0 z-40 overflow-visible border-b backdrop-blur"
>
  <div class="app-layout flex min-h-16 items-center justify-between py-3">
    <!-- Logo / Title -->
    <a href="/" class="flex items-center gap-3">
      {
        siteConfig.showLogo && siteConfig.logo ? (
          <img
            src={getAssetPath(siteConfig.logo)}
            alt={siteConfig.title}
            class="h-8 w-auto"
          />
        ) : (
          <span class="text-foreground font-ui text-2xl font-semibold tracking-tight">
            {siteConfig.title}
          </span>
        )
      }
    </a>

    <div class="nav-right flex flex-row items-center gap-4">
      <!-- Desktop Navigation -->
      <nav class="font-ui hidden items-center gap-6 text-sm sm:flex">
        {
          siteConfig.navigation.map((item) => (
            <a
              href={item.url}
              class="nav-link link-hover tracking-wide"
              aria-current={isActive(item.url) ? "page" : undefined}
            >
              {item.title}
            </a>
          ))
        }
      </nav>

      <!-- Actions -->
      <div class="font-ui flex items-center gap-4">
        <!-- <pagefind-modal-trigger compact hide-shortcut></pagefind-modal-trigger> -->
        <!-- <pagefind-searchbox></pagefind-searchbox> -->
        {
          siteConfig.showThemeToggle && (
            <button
              type="button"
              id="theme-toggle"
              class="theme-pill"
              aria-label="Toggle theme"
            />
          )
        }

        <!-- Mobile menu toggle -->
        <button
          id="menu-toggle"
          type="button"
          class="menu-toggle border-border text-muted-foreground hover:text-primary inline-flex h-8 w-8 items-center justify-center rounded border bg-transparent transition-colors duration-150 sm:hidden"
          aria-label="Toggle navigation"
          aria-expanded="false"
          aria-controls="mobile-drawer"
        >
          <span class="menu-toggle__icon" aria-hidden="true">
            <span class="menu-toggle__bar"></span>
            <span class="menu-toggle__bar"></span>
            <span class="menu-toggle__bar"></span>
          </span>
        </button>
      </div>
    </div>
  </div>
  <!-- Mobile Drawer -->
  <div id="mobile-drawer" class="mobile-drawer sm:hidden" aria-hidden="true">
    <div class="border-border border-t">
      {
        siteConfig.navigation.map((item) => (
          <a
            href={item.url}
            class="border-border font-ui text-muted-foreground link-hover aria-[current=page]:text-primary flex items-center justify-between border-b px-4 py-3.5 text-base last:border-b-0"
            aria-current={isActive(item.url) ? "page" : undefined}
          >
            <span>{item.title}</span>
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  function initMobileNav() {
    const toggle = document.getElementById("menu-toggle");
    const drawer = document.getElementById("mobile-drawer");
    if (!(toggle instanceof HTMLButtonElement) || !drawer) return;
    if (toggle.dataset.mobileNavBound === "true") return;

    toggle.dataset.mobileNavBound = "true";

    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      const next = !isOpen;
      toggle.setAttribute("aria-expanded", String(next));
      drawer.classList.toggle("open", next);
      drawer.setAttribute("aria-hidden", String(!next));
    });
  }

  initMobileNav();
  document.addEventListener("astro:after-swap", initMobileNav);
</script>

<style>
  .site-header {
    position: sticky;

    animation: header-shadow linear both;
    animation-timeline: scroll();
    animation-range: 0px 1px;
  }

  @keyframes header-shadow {
    from {
      box-shadow: none;
    }
    to {
      box-shadow: 0 1px 12px 0
        color-mix(in srgb, var(--foreground) 8%, transparent);
    }
  }

  /* ── Theme pill ────────────────────────────────────── */
  .theme-pill {
    width: 36px;
    height: 20px;
    border-radius: 10px;
    border: 0.5px solid var(--border);
    background: var(--muted);
    position: relative;
    flex-shrink: 0;
    transition:
      background 0.2s,
      border-color 0.2s;
  }

  .theme-pill::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--foreground);
    border: 0.5px solid var(--muted-foreground);
    transition:
      transform 0.18s ease,
      background 0.18s;
  }

  [data-theme="dark"] .theme-pill {
    background: var(--muted-foreground);
    border-color: var(--muted-foreground);
  }

  html[data-theme="dark"] .theme-pill::after {
    /* [data-theme="dark"] .theme-pill::after { */
    transform: translateX(16px);
    background: var(--foreground);
  }

  /* ── Mobile menu toggle ────────────────────────────── */
  .menu-toggle__icon {
    position: relative;
    display: block;
    width: 14px;
    height: 14px;
  }

  .menu-toggle__bar {
    position: absolute;
    left: 0;
    width: 14px;
    height: 1.5px;
    border-radius: 999px;
    background: currentColor;
    transform-origin: center;
    transition:
      top 0.22s ease,
      transform 0.22s ease,
      opacity 0.16s ease;
  }

  .menu-toggle__bar:nth-child(1) {
    top: 2px;
  }

  .menu-toggle__bar:nth-child(2) {
    top: 6.25px;
  }

  .menu-toggle__bar:nth-child(3) {
    top: 10.5px;
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__bar:nth-child(1) {
    top: 6.25px;
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0.2);
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__bar:nth-child(3) {
    top: 6.25px;
    transform: rotate(-45deg);
  }

  /* ── Mobile drawer ─────────────────────────────────── */
  .mobile-drawer {
    background: var(--background);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 4pt 24pt color-mix(in srgb, var(--foreground) 5%, transparent);
    /* box-shadow: 0 4pt 24pt rgba(0,0,0,0.05); */
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.25s ease;
  }

  .mobile-drawer.open {
    max-height: 400px;
  }
</style>
