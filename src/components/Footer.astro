---
import siteConfig from "@/site.config";
---

<footer class="border-border mt-12 border-t py-8">
  <div class="app-layout">
    <div class="flex flex-col items-center gap-4">
      <span class="block text-xl font-semibold tracking-tight">
        {siteConfig.author}<span class="text-primary font-normal">.</span>
      </span>

      {
        siteConfig.footerLinks.length > 0 && (
          <nav
            class="font-ui text-muted-foreground flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm"
            aria-label="Footer links"
          >
            {siteConfig.footerLinks.map((item) => (
              <a href={item.url} class="link-hover">
                {item.title}
              </a>
            ))}
          </nav>
        )
      }

      {
        siteConfig.social.length > 0 && (
          <nav
            class="font-ui text-muted-foreground flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm"
            aria-label="Social links"
          >
            {siteConfig.social.map((item) => (
              <a
                href={item.url}
                class="link-hover"
                rel={
                  item.url.startsWith("http")
                    ? "me noopener noreferrer"
                    : undefined
                }
              >
                {item.title}
              </a>
            ))}
          </nav>
        )
      }
    </div>
  </div>
</footer>
