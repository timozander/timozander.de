---
import { getPostUrl, type Post } from "@/utils/content";
import { slugify } from "@/utils/text";

type Props = {
  tag?: "h1" | "h2";
  post: Post;
  class?: string;
};

const { tag: Heading = "h2", post, class: className = "" } = Astro.props;

const url = getPostUrl(post);
const titleSlug = slugify(post.data.title.replaceAll(".", "-"));
const titleClass = ["text-balance", className].filter(Boolean).join(" ");
---

<a href={url} class="hover:text-primary no-underline">
  <Heading class={titleClass} transition:name={titleSlug}>
    {post.data.title}
  </Heading>
</a>
