{
	"name": "timozander.de",
	"type": "module",
	"version": "3.0.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build && npx pagefind --site dist && cp -r dist/pagefind public/",
		"preview": "astro preview",
		"check": "astro check",
		"lint": "biome lint . && npm run lint:posts",
		"lint:posts": "node scripts/check-post-order.mjs",
		"format": "npm run format:code && npm run format:imports",
		"format:code": "biome format . --write && prettier -w \"**/*\" --ignore-unknown --cache",
		"format:imports": "biome check --formatter-enabled=false --write",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.2.2",
		"@astrojs/mdx": "^7.0.5",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.3",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.1.6",
		"glightbox": "^3.3.1",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"rehype-unwrap-images": "^1.0.0",
		"remark-gfm": "^4.0.1",
		"satori": "^0.29.0",
		"satori-html": "^0.3.2",
		"string-similarity-js": "^2.1.4",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.6",
		"pagefind": "^1.5.2",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"typescript": "^6.0.3"
	},
	"private": true,
	"packageManager": "npm@10.9.0"
}
